# =====================================================
# AI Mental Health Chatbot - Environment Configuration
# =====================================================

# Optional: Add your Google Gemini API Key from Google AI Studio (https://aistudio.google.com/)
# If not provided, the chatbot seamlessly falls back to its built-in local ML & Coping strategies engine!
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key
SECRET_KEY=change_this_to_a_random_secure_secret_in_production

# Server Port (Defaults to 5000)
PORT=5000
